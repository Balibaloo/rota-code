+def test_the_wake_sets_the_provenance(db, tmp_path):
+    """
+    Law 11 by the wake (frame 20, 2026-09-16). A message wake is the seat's
+    own inference, so its rows are `reasoned`. An onboarding tick reads the
+    code, so its rows are `observed`. `decided` rests on a ruling of the
+    principal and is written by `adopt` alone.
+    """
+    from rota.core import config
+    from rota.onboarding import boot
+    from rota.testkit import gitfixture
+
+    backend = ScriptedBackend([
+        "TOOL: problem.assert(id='i1', text='users can delete their account', kind='in_scope')",
+        "Done.",
+    ])
+    outcome = run_session(db, wake_vision_keeper(), backend=backend,
+                          pins=Pins(model="scripted"))
+    assert outcome.committed, outcome.errors
+    row = db.execute("SELECT provenance FROM items WHERE id='i1'").fetchone()
+    assert row["provenance"] == "reasoned"
+
+    repo = gitfixture.make(tmp_path)
+    try:
+        conn = init_db(tmp_path / "onboard.db")
+        boot.onboard(conn, repo.root)
+        config.set(conn, "onboarding_phases", "survey")
+        conn.execute("INSERT INTO survey_records (id, area, outcome) VALUES "
+                     "('terminologist:src/billing', 'src/billing', 'none_found')")
+        conn.commit()
+        out = run_session(conn, Wake("architect", "tick:survey", refs=("src/billing",)),
+                          backend=ScriptedBackend([
+                              "TOOL: model.describe(account='Computes what an account "
+                              "owes and issues invoices for it; charges come in, "
+                              "invoices go out.')\n"
+                              "TOOL: surveys.attest(outcome='none_found', "
+                              "citations=['src/billing/charges.py'])",
+                              "done", "done"]),
+                          pins=Pins(model="scripted"))
+        assert out.committed, out.errors
+        row = conn.execute("SELECT provenance FROM model_areas WHERE id='src/billing'").fetchone()
+        assert row["provenance"] == "observed"
+    finally:
+        gitfixture.cleanup(repo)
+
+
