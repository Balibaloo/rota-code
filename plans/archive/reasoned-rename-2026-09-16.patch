+def test_an_observed_session_never_amends_a_reasoned_item(project):
+    """
+    Frame 20 (2026-09-16): a seat's own inference is `reasoned`. The guard
+    that holds a decided item against an observed session holds a reasoned
+    item the same way. Found never overwrites reasoned.
+    """
+    from rota.roles.api import Ctx, problem_assert
+
+    db, repo = project
+    boot.onboard(db, repo.root)
+    db.execute("INSERT INTO items (id, text, kind, provenance, approval, "
+               "approval_ver, version) VALUES ('split_bill', 'the bill is split', "
+               "'in_scope', 'reasoned', 'approved', 1, 1)")
+    db.commit()
+    ctx = Ctx(conn=db, role="vision_keeper", area=PROGRAM, provenance="observed")
+    got = problem_assert(ctx, id="split_bill", text="the program splits the bill")
+    assert got["id"] == "split_bill" and "reasoned" in got.get("note", ""), got
+    assert not [w for w in ctx.writes if w[0] == "items"], "observed wrote over reasoned"
+    row = db.execute("SELECT provenance, text FROM items WHERE id='split_bill'").fetchone()
+    assert (row["provenance"], row["text"]) == ("reasoned", "the bill is split")
+
