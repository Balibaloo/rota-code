+# Frame 61: a refused write stays in view until a matching call returns OK.
+# On night 88, 14 refused writes were never met, and a cut hid two refusals
+# before the seat read them (frame 61's design record).
+_BAD_I1 = "TOOL: problem.assert(id='i1', text='x', kind='sideways')"
+_GOOD_I1 = "TOOL: problem.assert(id='i1', text='x', kind='in_scope')"
+_READ = "TOOL: decisions.search(query='scope')"
+_OWED_END = "ended with a call still owed: problem.assert(id='i1')"
+
+
+def _owed_lines(user):
+    return [line for line in user.split("\n") if line.startswith("OWED ")]
+
+
+def _run(db, script):
+    backend = ScriptedBackend(script)
+    outcome = run_session(db, wake_vision_keeper(), backend=backend,
+                          pins=Pins(model="scripted"))
+    assert outcome.committed, outcome.errors
+    return backend, outcome
+
+
+def test_a_refused_write_is_owed_until_a_matching_call_returns_ok(db):
+    backend, outcome = _run(db, [_BAD_I1, _READ, _GOOD_I1, "Done."])
+    last = backend.calls[2][1].split("\n")[-1]
+    assert last.startswith("OWED problem.assert(id='i1'): refused earlier "
+                           "this session: "), last
+    assert "It is not done until a call of problem.assert(id='i1') returns OK" in last
+    assert not _owed_lines(backend.calls[3][1]), "the matching success clears it"
+    assert _OWED_END not in outcome.errors
+
+
+def test_a_success_under_another_tag_does_not_clear_the_debt(db):
+    backend, _ = _run(db, [
+        _BAD_I1,
+        "TOOL: problem.assert(id='i2', text='y', kind='in_scope')",
+        "Done."])
+    assert [line.split(":", 1)[0] for line in _owed_lines(backend.calls[2][1])] \
+        == ["OWED problem.assert(id='i1')"]
+
+
+def test_the_session_end_names_a_call_still_owed(db):
+    _, owing = _run(db, [_BAD_I1, "Done."])
+    assert _OWED_END in owing.errors
+
+    db.execute("DELETE FROM items")
+    db.execute("UPDATE messages SET status='open' WHERE id='m1'")
+    _, met = _run(db, [_BAD_I1, _GOOD_I1, "Done."])
+    assert not any(e.startswith("ended with a call still owed") for e in met.errors)
+
+
