+def test_fit_pays_a_reserve_from_the_middle_and_keeps_the_wake_whole():
+    """Frame 61's design review, finding 5: a smaller budget cut a
+    6,000-character wake. The reserve is paid by the middle only."""
+    from rota.core.runner import _fit
+
+    wake = "WAKE " + "w" * 5995
+    blocks = [wake] + [f"middle {k} " + "m" * 990 for k in range(4)] + ["r" * 500, "s" * 500]
+    assert _fit(list(blocks), budget=12_000) == blocks
+
+    fitted = _fit(list(blocks), budget=12_000, reserve=1_500)
+    assert fitted[0] == wake, "the reserve cut the wake"
+    assert fitted[-2:] == blocks[-2:]
+    assert "dropped to fit the window" in fitted[1], fitted[1][:200]
+    assert sum(len(t) + 2 for t in fitted) + 1_500 <= 12_000
