+# The owed block's limits. Three lines at about 500 characters each is 1,500
+# characters a turn at most (frame 61's design record, revision 2, point 8).
+_OWED_LINES = 3
+_OWED_REFUSALS = 3
+# An op name in a door's text, `word.word`: the call the door names as a cure.
+_DOTTED_OP = re.compile(r"\b[a-z_]+\.[a-z_]+\b")
+
+
+def _owed_reason(reason: str) -> str:
+    """
+    The head names the subject and the tail names the passing call. A cut of
+    the tail alone lost the subject in 21 of 201 door texts (frame 61's
+    design review, finding 1).
+    """
+    if len(reason) <= 300:
+        return reason
+    return reason[:100] + "..." + reason[-200:]
+
+
+def _owed_block(owed: dict[str, dict[str, Any]]) -> str:
+    """
+    One line per call still owed, oldest first, abandoned calls left out.
+    The line names a time and never a place in the prompt, because a
+    backward pointer scored 0 of 5 four times (frame 46's re-earning pass).
+    It starts with `OWED` and not `ERROR`: `FABRICATED_RESULT` reads an
+    echoed `ERROR` line as an invented result.
+    """
+    lines = []
+    for tag, entry in owed.items():
+        if entry["abandoned"]:
+            continue
+        lines.append(
+            f"OWED {tag}: refused earlier this session: "
+            f"{_owed_reason(entry['reason']).rstrip('.')}. It is not done until a call of "
+            f"{tag} returns OK. If it cannot be done, say so in one sentence "
+            f"and do not report it as done.")
+        if len(lines) == _OWED_LINES:
+            break
+    return "\n".join(lines)
+
