{
  "nodes": [
    {
      "id": "client",
      "label": "Client",
      "type": "client",
      "note": "Technical. Synchronous. Holds final authority. Optional PR gate."
    },
    {
      "id": "interface",
      "label": "Interface",
      "type": "role",
      "note": "Only role that sees the client. Records and broadcasts; does not interpret. Fields every client message as inquiry first: consult-mode sessions answer questions read-only — no writes, so nothing revokes and no checkpoint is disturbed. Only a ratified amendment to an approved item escalates an inquiry into change."
    },
    {
      "id": "vision",
      "label": "Vision",
      "type": "role",
      "note": "Identity and scope over time. Owns non-goals, the rejection log, and the check of every new statement against prior refusals — including noticing when an old no has expired."
    },
    {
      "id": "domain",
      "label": "Domain",
      "type": "role",
      "note": "Terms and business rules. Catches contradictions in the dump."
    },
    {
      "id": "architect",
      "label": "Architect",
      "type": "role",
      "note": "Feasibility and constraints. Groups tickets into batches — a dependency-and-collision judgement that lives in the system model."
    },
    {
      "id": "schedule",
      "label": "Batch schedule",
      "type": "artefact",
      "note": "Order between batches, derived by the scheduler as a topological sort of Architect's declared dependency facts. No dates. Not owned by any role: ordering carries no judgement beyond the deps, so there is nothing for a role to decide. Unsatisfiable deps (a cycle) wake Architect with the conflicting facts.",
      "owner": "scheduler"
    },
    {
      "id": "developer",
      "label": "Developer",
      "type": "role",
      "note": "Awoken per batch, cold. Implements against criteria. Its contact list is the writers of its read set: term questions go to Domain, criterion and scope gaps to Vision, constraint conflicts to Architect. Interface is reached only through an owner reporting blocked."
    },
    {
      "id": "critic",
      "label": "Critic",
      "type": "role",
      "note": "Judges diff against intent. Never sees the developer reasoning."
    },
    {
      "id": "transcript",
      "label": "Transcript",
      "type": "artefact",
      "note": "Append-only, verbatim utterances with IDs. Nobody reads it in bulk. It exists so interpretations can be adjudicated against something un-interpreted.",
      "contact": false,
      "contact_why": "verbatim record; read to recover emphasis, never to ask its recorder"
    },
    {
      "id": "brief",
      "label": "Brief (statements)",
      "type": "artefact",
      "note": "Atomised statements, each with provenance into the transcript and a status: asserted, clarified, superseded, contradicted. Ratified by the client, so segmentation can be aggressive."
    },
    {
      "id": "problem",
      "label": "Problem statement",
      "type": "artefact",
      "note": "Scope items and non-goals, each carrying its own approval state. No batch may be scheduled unless the item it satisfies is approved and that approval postdates the item’s last amendment."
    },
    {
      "id": "glossary",
      "label": "Glossary + rules",
      "type": "artefact",
      "note": "Canonical meaning of every term. Entries carry provenance: ratified by the client, or observed — extracted from an onboarded codebase and awaiting confirmation."
    },
    {
      "id": "model",
      "label": "System model",
      "type": "artefact",
      "note": "Constraints, and what is buildable here. Each constraint declares bindings — the modules it governs — so the structural-review trigger is a path intersection the scheduler computes, not a judgement anyone makes. Unbound constraints are global and trigger on every diff. Entries carry provenance: decided (authored reason on file) or observed (inherited from an onboarded codebase — found, not chosen). Challenging an observed entry forces its first decision."
    },
    {
      "id": "decisions",
      "label": "Decision record",
      "type": "artefact",
      "note": "Append-only journal, multiple writers: each decision is authored by whoever made it, at the moment they made it. One author per entry, no shared state — which is why multi-writer is safe here and not on the backlog.",
      "contact": false,
      "contact_why": "append-only journal; entries carry authors but are read as evidence"
    },
    {
      "id": "ledger",
      "label": "Assumption ledger",
      "type": "artefact",
      "note": "Any role writes. Becomes the agenda for the next client turn.",
      "contact": false,
      "contact_why": "append-only journal; open assumptions are facts to present, not questions"
    },
    {
      "id": "code",
      "label": "Codebase + diffs",
      "type": "artefact",
      "note": "One branch and worktree per batch, never reused. Restarting a revoked batch wipes its worktree. Preemption kills a batch’s runtime whole — processes and ports die with it, half-dead environments forbidden — while the worktree and its commits persist as deferred work (commit-first bounds the loss).",
      "contact": false,
      "contact_why": "self-describing; a question about the codebase is answered by probing it"
    },
    {
      "id": "verdicts",
      "label": "Review verdicts",
      "type": "artefact",
      "note": "Pass, or the criterion that failed."
    },
    {
      "id": "tester",
      "label": "Tester",
      "type": "role",
      "note": "Writes executable tests from criteria, before the Developer's diff exists and without ever seeing it. Its isolation is temporal, not informational: Critic can read everything Tester reads, so the only thing that makes these tests intent rather than description is that they were written first. Do not merge this role into Critic."
    },
    {
      "id": "tests",
      "label": "Test suite",
      "type": "artefact",
      "note": "Criteria made executable. Machine-ratified intent: outranks all prose in the repo as evidence. One suite per batch, refs the criteria it encodes."
    },
    {
      "id": "tickets",
      "label": "Tickets",
      "type": "artefact",
      "note": "Sliced by Vision from approved items. One writer. Tickets (Vision), criteria (Domain), batches (Architect) — one writer per table, which is what law 1 means by single writer: one writer per row. Batches are complete feature sets, immutable once formed: priority moves them whole; only a scope change may recompose one. One worktree and one PR per batch, tracing to exactly one approved item."
    },
    {
      "id": "criteria",
      "label": "Criteria",
      "type": "artefact",
      "note": "Written by Domain in glossary terms, one set per ticket. One writer."
    },
    {
      "id": "batches",
      "label": "Batches",
      "type": "artefact",
      "note": "Ticket groups formed by Architect on collision judgement. Complete feature sets, immutable once formed: priority moves them whole, and only a scope change may recompose one. One worktree and one PR per batch, tracing to exactly one approved item."
    }
  ],
