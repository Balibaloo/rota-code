{
  "nodes": [
    {
      "id": "principal",
      "label": "Principal",
      "type": "principal",
      "note": "Technical. Synchronous. Holds final authority. Optional PR gate."
    },
    {
      "id": "liaison",
      "label": "Liaison",
      "type": "role",
      "note": "Only role that sees the principal. Records and broadcasts; does not interpret. Fields every principal message as inquiry first: consult-mode sessions answer questions read-only \u2014 no writes, so nothing revokes and no checkpoint is disturbed. Only a ratified amendment to an approved item escalates an inquiry into change."
    },
    {
      "id": "gatekeeper",
      "label": "Gatekeeper",
      "type": "role",
      "note": "Identity and scope over time. Owns the out-of-scope items, the rejection log, and the check of every new statement against prior refusals \u2014 including noticing when an old no has expired."
    },
    {
      "id": "terminologist",
      "label": "Terminologist",
      "type": "role",
      "note": "Terms and business rules. Catches contradictions in the dump."
    },
    {
      "id": "architect",
      "label": "Architect",
      "type": "role",
      "note": "Feasibility and constraints. Groups tickets into batches \u2014 a dependency-and-collision judgement that lives in the system model."
    },
    {
      "id": "schedule",
      "label": "Batch schedule",
      "type": "artefact",
      "note": "Order between batches, derived by the scheduler as a topological sort of Architect's declared dependency facts. No dates. Not owned by any role: ordering carries no judgement beyond the deps, so there is nothing for a role to decide. Unsatisfiable deps (a cycle) wake Architect with the conflicting facts.",
      "owner": "scheduler"
    },
    {
      "id": "developer",
      "label": "Developer",
      "type": "role",
      "note": "Awoken per batch, cold. Implements against criteria. Its contact list is the writers of its read set: term questions go to Terminologist, criterion and scope gaps to Gatekeeper, constraint conflicts to Architect. Liaison is reached only through an owner reporting blocked."
    },
    {
      "id": "critic",
      "label": "Critic",
      "type": "role",
      "note": "Judges diff against intent. Never sees the developer reasoning."
    },
    {
      "id": "transcript",
      "label": "Transcript",
      "type": "artefact",
      "note": "Append-only, verbatim entries with IDs. Nobody reads it in bulk. It exists so interpretations can be adjudicated against something un-interpreted.",
      "contact": false,
      "contact_why": "verbatim record; read to recover emphasis, never to ask its recorder"
    },
    {
      "id": "brief",
      "label": "Brief (statements)",
      "type": "artefact",
      "note": "Atomised statements, each with provenance into the transcript and a status: asserted, clarified, superseded, contradicted. Ratified by the principal, so segmentation can be aggressive."
    },
    {
      "id": "problem",
      "label": "Problem statement",
      "type": "artefact",
      "note": "In-scope and out-of-scope items, each carrying its own approval state. No batch may be scheduled unless the item it satisfies is approved and that approval postdates the item\u2019s last amendment."
    },
    {
      "id": "glossary",
      "label": "Glossary + rules",
      "type": "artefact",
      "note": "Canonical meaning of every term. Entries carry provenance: ratified by the principal, or observed \u2014 extracted from an onboarded codebase and awaiting confirmation."
    },
    {
      "id": "model",
      "label": "System model",
      "type": "artefact",
      "note": "Constraints, and what is buildable here. Each constraint declares bindings \u2014 the modules it governs \u2014 so the structural-review trigger is a path intersection the scheduler computes, not a judgement anyone makes. Unbound constraints are global and trigger on every diff. Entries carry provenance: decided (authored reason on file) or observed (inherited from an onboarded codebase \u2014 found, not chosen). Challenging an observed entry forces its first decision."
    },
    {
      "id": "decisions",
      "label": "Decision record",
      "type": "artefact",
      "note": "Append-only journal, multiple writers: each decision is authored by whoever made it, at the moment they made it. One author per entry, no shared state \u2014 which is why multi-writer is safe here and not on the backlog.",
      "contact": false,
      "contact_why": "append-only journal; entries carry authors but are read as evidence"
    },
    {
      "id": "ledger",
      "label": "Assumption ledger",
      "type": "artefact",
      "note": "Any role writes. Becomes the agenda for the next principal turn.",
      "contact": false,
      "contact_why": "append-only journal; open assumptions are facts to present, not questions"
    },
    {
      "id": "code",
      "label": "Codebase + diffs",
      "type": "artefact",
      "note": "One branch and worktree per batch, never reused. Restarting a revoked batch wipes its worktree. Preemption kills a batch\u2019s runtime whole \u2014 processes and ports die with it, half-dead environments forbidden \u2014 while the worktree and its commits persist as deferred work (commit-first bounds the loss).",
      "contact": false,
      "contact_why": "self-describing; a question about the codebase is answered by probing it"
    },
    {
      "id": "verdicts",
      "label": "Review verdicts",
      "type": "artefact",
      "note": "Pass, or the criterion that failed."
    },
    {
      "id": "tester",
      "label": "Tester",
      "type": "role",
      "note": "Writes executable tests from criteria, before the Developer's diff exists and without ever seeing it. Its isolation is temporal, not informational: Critic can read everything Tester reads, so the only thing that makes these tests intent rather than description is that they were written first. Do not merge this role into Critic."
    },
    {
      "id": "tests",
      "label": "Test suite",
      "type": "artefact",
      "note": "Criteria made executable. Machine-ratified intent: outranks all prose in the repo as evidence. One suite per batch, refs the criteria it encodes."
    },
    {
      "id": "tickets",
      "label": "Tickets",
      "type": "artefact",
      "note": "Sliced by Gatekeeper from approved items. One writer. Tickets (Gatekeeper), criteria (Terminologist), batches (Architect) \u2014 one writer per table, which is what law 1 means by single writer: one writer per row. Batches are complete feature sets, immutable once formed: priority moves them whole; only a scope change may recompose one. One worktree and one PR per batch, tracing to exactly one approved item."
    },
    {
      "id": "criteria",
      "label": "Criteria",
      "type": "artefact",
      "note": "Written by Terminologist in glossary terms, one set per ticket. One writer."
    },
    {
      "id": "batches",
      "label": "Batches",
      "type": "artefact",
      "note": "Ticket groups formed by Architect on collision judgement. Complete feature sets, immutable once formed: priority moves them whole, and only a scope change may recompose one. One worktree and one PR per batch, tracing to exactly one approved item."
    },
    {
      "id": "findings",
      "label": "Findings",
      "type": "artefact",
      "contact": false,
      "contact_why": "Architect's structural verdict on one batch. Read by the merge gate, which is the scheduler, not a role \u2014 so there is nobody to ask about one.",
      "note": "Constraint id, satisfied or violated, and the grain that brought the constraint into range. No reasoning: law 2. One row per constraint checked, per commit."
    },
    {
      "id": "surveys",
      "label": "Survey records",
      "type": "artefact",
      "contact": false,
      "contact_why": "a receipt that an area was looked at, by whom, with what result -- read by the scheduler, which is not a role, so there is nobody to ask about one",
      "note": "One row per role per area of an onboarded codebase: found or none_found, with citations naming the grains actually read. Its own artefact rather than part of the model, for the same reason findings are: onboarding runs Terminologist, Architect and Gatekeeper over every area and each must record its own pass, which under `model` would have meant three writers on Architect's artefact -- and did mean the two who could not write one were woken for the same area forever."
    },
    {
      "id": "researcher",
      "label": "Researcher",
      "type": "role",
      "note": "Answers questions of fact about things outside this repository, with sources. Does not judge, implement, or set scope. Owns no shared artefact: it writes references and the asking role decides whether to cite them, so nothing enters the model unless a role with ownership put it there. Never woken by a predicate -- it drains nothing, so a predicate waking it would fire forever; external push arrives through the owner of whatever cited the stale reference. Knows nothing of batches, criteria or constraints: questions from roles, answers with sources."
    },
    {
      "id": "references",
      "label": "References",
      "type": "artefact",
      "note": "What an outside source says, and where. One row per source: the URL, the passage, the claim it supports, and a content hash that makes the page changing a drift event rather than a silent lie. The quote is not decoration -- everywhere else conclusions travel and reasoning stays home, but for an external source the passage IS the evidence, and without it nobody can check whether the Researcher read it correctly."
    },
    {
      "id": "web",
      "label": "The open web",
      "type": "artefact",
      "owner": "world",
      "contact": false,
      "contact_why": "a fact artefact, and the only one outside the engagement: reading it yields evidence, not judgement, and there is nobody in this system to ask about it",
      "note": "Reachable only from the Researcher, and only within the domain allowlist the principal configures. Queries are constructed from the question, never forwarded: the asker may put whatever context it likes into a question, and that context must not reach the wire."
    }
  ],
