# Normalise line endings on the way into git.
#
# Without this, every file written on Windows was staged CRLF and git warned
# on each one — a wall of "CRLF will be replaced by LF" per commit, and enough
# noise to bury anything worth reading in the same output.
* text=auto eol=lf

# Binary, so that eol conversion never touches these.
#
# `tests/rota/cassettes.db` is not tracked here. The file is 590 MB and a new
# version lands most days, so 153 versions of it had reached 57 GB of Git LFS.
# The database is gitignored and lives beside the checkout. `rota/README.md`
# says where to get it.
*.db binary
*.zip binary
*.png binary
